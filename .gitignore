```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Test cache
.pytest_cache/
.coverage
coverage/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
*.env.*
```